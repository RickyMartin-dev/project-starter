#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
# Git exports repository-local variables to hooks. Clear them before project
# checks create fixture repositories and linked worktrees, or relative values
# such as GIT_DIR=.git can point at the worktree's .git file instead.
while IFS= read -r git_env_var; do
  unset "$git_env_var"
done < <(git rev-parse --local-env-vars)

"$ROOT_DIR/scripts/project" check
