# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Operating-system and editor noise
.DS_Store
.idea/
.vscode/*.local.json

# Agent-local state and transcripts
.agent-state/
.codex/*
!.codex/hooks.json
.claude/settings.local.json
.cursor/*.local.json
.cursor/mcp.json

# Common build output; keep project-specific entries below.
dist/
build/
coverage/
*.log

# Impeccable engine binaries download per platform on first run; local design state stays local.
.agents/skills/impeccable/scripts/bin/
.claude/skills/impeccable/scripts/bin/
.cursor/skills/impeccable/scripts/bin/
.impeccable/*.local.json
.impeccable/hook.cache.json
